[
  {
    "layer": "top",
    "position": "right",
    "height": "100%",
    "width": 34,
    "modules-left": [],
    "modules-center": [],
    "modules-right": []
  },
  {
    "layer": "top",
    "position": "top",
    "height": 20,
    "modules-left": [],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": [],

    "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "default": "󰄰",
        "active": "",
        "1": "",
        "2": "󱁍",
        "3": "󱡝",
        "4": "",
        "5": "󰭕"
      },
      "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5]
      }
    }
  },
  {
    "layer": "top",
    "position": "left",
    "height": "100%",
    "width": 25,
    "modules-left": [],
    "modules-center": [],
    "modules-right": []
  },
  {
    "layer": "top",
    "position": "bottom",
    "height": 20,
    "modules-left": ["bluetooth", "network", "pulseaudio"],
    "modules-center": ["battery"],
    "modules-right": ["cpu"],

    "battery": {
      "states": {
        "good": 80,
        "warning": 30,
        "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-plugged": " {capacity}%",
      "format-full": "󰁹 100%",
      "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "interval": 10
    },

    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "󰖁",
      "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
      },
      "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
      "on-click-right": "pavucontrol",
      "scroll-step": 1,
      "tooltip": false
    },

    "network": {
      "format": "{ifname}",
      "format-wifi": "󰖩 ",
      "format-ethernet": "󰈀 ",
      "format-disconnected": "󰖪 ",
      "tooltip-format": "{ifname} via {gwaddr} ({ipaddr}/{cidr})\\n{essid} ({signalStrength}%)",
      "on-click": "networkmanager_dmenu",
      "on-click-right": "alacritty -e nmtui"
    },

    "bluetooth": {
      "format-disabled": "󰂲",
      "format-on": "󰂯",
      "format-connected": "󰂯",
      "format-off": "󰂲",
      "on-click": "blueman-manager"
    },

    "cpu": {
      "format": "󰍛 {usage}%",
      "interval": 2
    }
  }
]
