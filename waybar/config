[
  {
    "layer": "top",
    "position": "right",
    "height": "100%",
    "width": 34,
    "modules-left": [],
    "modules-center": [],
    "modules-right": []
  },
  {
    "layer": "top",
    "position": "top",
    "height": 20,
    "modules-left": ["hyprland/workspaces", "clock"],
    "modules-center": [],
    "modules-right": ["custom/separator", "custom/wifi", "custom/separator", "custom/bluetooth", "custom/separator", "custom/volume_bar", "custom/separator", "custom/brightness_bar", "custom/separator", "custom/battery_bar", "custom/separator"],
    "custom/brightness_bar": {
      "exec": "~/.config/waybar/scripts/brightness_bar.sh",
      "interval": 1,
      "return-type": "json",
      "format": "{text}",
      "max": 100,
      "bar-width": 120,
      "bar-symbol": "󰃠 ",
      "bar-alt-symbol": "󰃞 ",
      "bar-empty": "─",
      "bar-filled": "━",
      "tooltip": false
    },

    "clock": {
      "format": "[󰥔 {:%a %d %b %H:%M | W%V}]",
      "tooltip-format": "{:%A, %d %B %Y | %H:%M:%S | Week %V}"
    },

    "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "default": "󰄰",
        "active": "",
        "1": "",
        "2": "󱁍",
        "3": "󱡝",
        "4": "",
        "5": "󰭕"
      },
      "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5]
      }
    },

    "custom/battery_bar": {
      "exec": "~/.config/waybar/scripts/battery_bar.sh",
      "interval": 5,
      "return-type": "json",
      "tooltip": false
    },

    "custom/wifi": {
      "exec": "sh -c 'if [ \"$(nmcli -t -f WIFI g 2>/dev/null)\" = \"enabled\" ]; then echo \"{\\\"text\\\": \\\"󰖩\\\", \\\"class\\\": \\\"connected\\\"}\"; else echo \"{\\\"text\\\": \\\"󰖪\\\", \\\"class\\\": \\\"disconnected\\\"}\"; fi'",
      "on-click": "networkmanager_dmenu",
      "on-right-click": "alacritty -e nmtui",
      "interval": 5,
      "return-type": "json",
      "tooltip": false
    },

    "custom/bluetooth": {
      "exec": "sh -c 'if bluetoothctl show 2>/dev/null | grep -q \"Powered: yes\"; then echo \"{\\\"text\\\": \\\"󰂯\\\", \\\"class\\\": \\\"connected\\\"}\"; else echo \"{\\\"text\\\": \\\"󰂲\\\", \\\"class\\\": \\\"disconnected\\\"}\"; fi'",
      "on-click": "sh -c 'blueman-manager >/dev/null 2>&1 &'",
      "interval": 5,
      "return-type": "json",
      "tooltip": false
    },

    "custom/volume_bar": {
      "exec": "~/.config/waybar/scripts/volume_bar.sh",
      "on-click": "sh -c 'pavucontrol >/dev/null 2>&1 &'",
      "interval": 1,
      "return-type": "json",
      "tooltip": false
    },

    "custom/separator": {
      "format": "|",
      "tooltip": false
    },

    "spacer": {
      "format": "",
      "min-width": 50
    }
  },
  {
    "layer": "top",
    "position": "left",
    "height": "100%",
    "width": 25,
    "modules-left": [],
    "modules-center": [],
    "modules-right": []
  },
  {
    "layer": "top",
    "position": "bottom",
    "height": 20,
    "modules-left": [],
    "modules-center": [],
    "modules-right": []
  }
]
