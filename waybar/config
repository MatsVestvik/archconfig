[
  {
    "layer": "top",
    "position": "right",
    "height": "100%",
    "width": 34,
    "modules-left": [],
    "modules-center": [],
    "modules-right": []
  },
  {
    "output": "eDP-1",
    "layer": "top",
    "position": "top",
    "height": 20,
    "modules-left": ["hyprland/workspaces", "clock"],
    "modules-center": [],
    "modules-right": ["custom/separator", "custom/wifi", "custom/separator", "custom/bluetooth", "custom/separator", "custom/volume_bar", "custom/separator", "custom/brightness_bar", "custom/separator", "custom/battery_bar", "custom/separator", "custom/power", "custom/separator"],
    "custom/brightness_bar": {
      "exec": "~/.config/waybar/scripts/brightness_control.sh internal status",
      "on-scroll-up": "~/.config/waybar/scripts/brightness_control.sh internal up",
      "on-scroll-down": "~/.config/waybar/scripts/brightness_control.sh internal down",
      "interval": 1,
      "return-type": "json",
      "format": "{text}",
      "tooltip": true
    },

    "clock": {
      "format": "[󰥔 {:%a %d %b %H:%M | W%V}]",
      "tooltip-format": "{:%A, %d %B %Y | %H:%M:%S | Week %V}"
    },

    "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "default": "󰄰",
        "active": "",
        "1": "",
        "2": "󱁍",
        "3": "󱡝",
        "4": "",
        "5": "󰭕"
      },
      "persistent-workspaces": {
        "eDP-1": [1, 2, 3, 4]
      }
    },

    "custom/battery_bar": {
      "exec": "~/.config/waybar/scripts/battery_bar.sh",
      "interval": 5,
      "return-type": "json",
      "tooltip": false
    },

    "custom/wifi": {
      "exec": "~/.config/waybar/scripts/wifi_status.sh",
      "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
      "on-right-click": "nm-connection-editor",
      "interval": 5,
      "return-type": "json",
      "tooltip": true
    },

    "custom/bluetooth": {
      "exec": "~/.config/waybar/scripts/bluetooth_status.sh",
      "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
      "on-right-click": "blueman-manager",
      "interval": 5,
      "return-type": "json",
      "tooltip": true
    },

    "custom/volume_bar": {
      "exec": "~/.config/waybar/scripts/volume_bar.sh",
      "on-click": "sh -c 'pavucontrol >/dev/null 2>&1 &'",
      "interval": 1,
      "return-type": "json",
      "tooltip": false
    },

    "custom/separator": {
      "format": "|",
      "tooltip": false
    },

    "custom/power": {
      "format": "󰐥",
      "on-click": "~/.config/waybar/scripts/power-menu.sh",
      "tooltip": true,
      "tooltip-format": "Power Menu\nLeft-click: Lock, Sleep, Log Off, Reboot, Turn Off"
    },

    "spacer": {
      "format": "",
      "min-width": 50
    }
  },
  {
    "output": "!eDP-1",
    "layer": "top",
    "position": "top",
    "height": 20,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": [],
    "modules-right": [],
    "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "default": "󰄰",
        "active": "",
        "1": "",
        "2": "󱁍",
        "3": "󱡝",
        "4": "",
        "5": "󰭕"
      },
      "persistent-workspaces": {
        "*": [5]
      }
    }
  },
  {
    "layer": "top",
    "position": "left",
    "height": "100%",
    "width": 25,
    "modules-left": [],
    "modules-center": [],
    "modules-right": []
  },
  {
    "layer": "top",
    "position": "bottom",
    "height": 20,
    "modules-left": [],
    "modules-center": [],
    "modules-right": []
  }
]
