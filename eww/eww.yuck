(defpoll time_text :interval "1s"
  "date +'%H:%M:%S'")

(defpoll date_text :interval "30s"
  "date +'%A, %d %B %Y'")

(defpoll week_text :interval "60s"
  "date +'Week %V'")

(defpoll wifi_icon :interval "5s"
  "sh -c 'if [ \"$(nmcli -t -f WIFI g 2>/dev/null)\" = \"enabled\" ]; then echo \"󰖩\"; else echo \"󰖪\"; fi'")

(defpoll bt_icon :interval "5s"
  "sh -c 'if bluetoothctl show 2>/dev/null | grep -q \"Powered: yes\"; then echo \"󰂯\"; else echo \"󰂲\"; fi'")

(defpoll audio_icon :interval "2s"
  "sh -c 'if wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED; then echo \"󰖁\"; else echo \"󰕾\"; fi'")


(defvar pet_image_path "/home/mats/.config/eww/mudkip.png")

(defwindow time_widget
  :monitor 0
  :stacking "bg"
  :focusable false
  :geometry (geometry :x "45px" :y "30px" :width "300px" :height "68px" :anchor "top right")
  (info_box :title "Time" :value time_text))

(defwindow date_widget
  :monitor 0
  :stacking "bg"
  :focusable false
  :geometry (geometry :x "45px" :y "108px" :width "300px" :height "68px" :anchor "top right")
  (info_box :title "Date" :value date_text))

(defwindow week_widget
  :monitor 0
  :stacking "bg"
  :focusable false
  :geometry (geometry :x "45px" :y "186px" :width "300px" :height "68px" :anchor "top right")
  (info_box :title "Week" :value week_text))

(defwindow controls_icons_widget
  :monitor 0
  :stacking "bg"
  :focusable false
  :geometry (geometry :x "45px" :y "264px" :width "300px" :height "58px" :anchor "top right")
  (icons_controls))

(defwidget info_box [title value]
  (box :class "info-card" :orientation "vertical"
    (label :class "info-title" :text title)
    (label :class "info-value" :text value)))

(defwidget icons_controls []
  (box :class "icons-card"
    (button :class "icon-btn" :onclick "sh -c 'if [ \"$(nmcli -t -f WIFI g 2>/dev/null)\" = \"enabled\" ]; then nmcli radio wifi off; else nmcli radio wifi on; fi'"
      (label :class "icon-glyph" :text wifi_icon))
    (button :class "icon-btn" :onclick "sh -c 'if bluetoothctl show 2>/dev/null | grep -q \"Powered: yes\"; then bluetoothctl power off; else bluetoothctl power on; fi'"
      (label :class "icon-glyph" :text bt_icon))
    (button :class "icon-btn" :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
      (label :class "icon-glyph" :text audio_icon))))

(defwindow ascii_widget
  :monitor 0
  :stacking "bg"
  :focusable false
  :geometry (geometry :x "45px" :y "340px" :width "300px" :height "240px" :anchor "top right")
  (ascii_display))

(defwidget ascii_display []
  (box :class "ascii-container" :orientation "vertical" :hexpand true :vexpand true :halign "fill" :valign "fill"
    (box :orientation "vertical" :hexpand true :vexpand true :halign "fill" :valign "fill"
      (image :class "pet-image" :path pet_image_path :image-width 300 :image-height 300 :halign "center" :valign "center"))))

